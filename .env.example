# Instagram Graph API credentials.
# Copy this file to `.env` and fill in your values. NEVER commit your real .env.
#
# How to obtain these:
#   1. Create a Meta app at https://developers.facebook.com/apps
#   2. Connect an Instagram Business or Creator account to a Facebook Page.
#   3. Generate a long-lived User access token with these permissions:
#        instagram_basic, instagram_manage_insights,
#        pages_show_list, pages_read_engagement, business_management
#      For comment analysis, also add (read-only):
#        instagram_manage_comments
#   4. Find your Instagram Business Account ID (the IG user id, not your @handle).
#
# See README.md for a step-by-step walkthrough.

# Long-lived access token.
IG_ACCESS_TOKEN=

# Your Instagram Business/Creator account ID (numeric).
IG_USER_ID=

# Graph API version to target (optional, defaults to v21.0).
IG_GRAPH_VERSION=v21.0
