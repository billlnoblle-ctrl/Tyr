{
  "name": "tyr",
  "version": "0.1.0",
  "description": "Analyze Instagram Business/Creator accounts via the official Instagram Graph API and compute engagement, growth, posting-pattern, and top-content metrics.",
  "type": "module",
  "bin": {
    "tyr": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
